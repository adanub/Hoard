<!--
  ToastHost — renders a ToastService's live toasts as a stack of floating cards in the bottom-right corner.
  Hit-test invisible so toasts never block the UI underneath. Set DataContext to a ToastService.
  ClipToBounds=False at every level (UserControl / ItemsControl / item ContentPresenter / panel) so each
  toast's drop shadow isn't cropped at its bounds; the 40px margin keeps the corner shadow off the window edge.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:Hoard.Desktop.Services"
             x:Class="Hoard.Desktop.Controls.ToastHost"
             x:DataType="svc:ToastService"
             IsHitTestVisible="False" ClipToBounds="False">

    <ItemsControl ItemsSource="{Binding Toasts}" ClipToBounds="False"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="40">
        <ItemsControl.Styles>
            <!-- The generated per-item container; stop it cropping the toast's shadow. -->
            <Style Selector="ContentPresenter">
                <Setter Property="ClipToBounds" Value="False"/>
            </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="12" ClipToBounds="False"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:ToastItem">
                <Border Classes.error="{Binding IsError}"
                        Background="{DynamicResource PopoverBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMd}" Padding="14,10"
                        BoxShadow="{DynamicResource ShadowMd}" MaxWidth="360" HorizontalAlignment="Right">
                    <Border.Styles>
                        <Style Selector="Border.error">
                            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveBrush}"/>
                        </Style>
                    </Border.Styles>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
