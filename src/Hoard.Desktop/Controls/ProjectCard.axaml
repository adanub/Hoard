<!--
  ProjectCard — the project board card (see Controls/ProjectCard.cs). Verbatim the gallery card: a 3-up collage
  cover (big tile + two stacked; muted placeholder with the picture icon where a thumbnail is missing) over the
  name and metadata line, then Open (primary) + Edit (secondary) buttons, both large. Self-bindings use #Root.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:Hoard.Desktop.Controls"
             x:Class="Hoard.Desktop.Controls.ProjectCard"
             x:Name="Root">

    <!-- The project card isn't clickable, so it reads as a CONCAVE INSET (recessed) panel rather than a
         floating card: no drop shadow, fill matching the page, and an inner dark-top + light-bottom bevel
         (ShadowInsetBevel) carving it in. Inner shadows need no outer room, so there's no reserve margin. -->
    <!-- Width comes from the host (FillWrapPanel stretches cards to fill the row; the gallery pins 240). -->
    <Border Padding="10" CornerRadius="{DynamicResource RadiusLg}"
            Background="{DynamicResource RecessedBrush}" BoxShadow="{DynamicResource ShadowInsetBevel}">
        <StackPanel Spacing="10">
            <!-- Collage sits INSIDE the well (padded) so the recessed beveled rim frames it; rounded all round.
                 It also gets its own concave inset bevel (overlaid — see below). -->
            <Border CornerRadius="{DynamicResource RadiusMd}" ClipToBounds="True">
                <Panel>
                <Grid Height="150" ColumnDefinitions="2*,2,*" RowDefinitions="*,2,*">
                    <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource MutedBrush}" ClipToBounds="True">
                        <Panel>
                            <Image Source="{Binding #Root.Thumb0}" Stretch="UniformToFill"/>
                            <ctrl:Icon Data="{StaticResource Icon.image}" Width="28" Height="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       IsVisible="{Binding #Root.Thumb0, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </Panel>
                    </Border>
                    <Border Grid.Column="2" Grid.Row="0" Background="{DynamicResource MutedBrush}" ClipToBounds="True">
                        <Image Source="{Binding #Root.Thumb1}" Stretch="UniformToFill"/>
                    </Border>
                    <Border Grid.Column="2" Grid.Row="2" Background="{DynamicResource MutedBrush}" ClipToBounds="True">
                        <Image Source="{Binding #Root.Thumb2}" Stretch="UniformToFill"/>
                    </Border>
                </Grid>
                    <!-- Inset bevel drawn OVER the collage: inset shadows render behind a Border's own child,
                         so the recessed look must be an overlay on top of the images. -->
                    <Border CornerRadius="{DynamicResource RadiusMd}" IsHitTestVisible="False"
                            BoxShadow="{DynamicResource ShadowInsetBevel}"/>
                </Panel>
            </Border>
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding #Root.Title}" FontWeight="SemiBold"/>
                <TextBlock Classes="muted" Text="{Binding #Root.MetaText}"/>
                <!-- Open fills the row; the pencil (Edit) stays a fixed square beside it. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" Theme="{StaticResource HoardButton}" Classes="lg" Content="Open"
                            Command="{Binding #Root.OpenCommand}"/>
                    <Button Grid.Column="1" Theme="{StaticResource HoardButton}" Classes="secondary"
                            Width="48" Height="48" Padding="0" Command="{Binding #Root.EditCommand}">
                        <ctrl:Icon Data="{StaticResource Icon.pencil}" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
