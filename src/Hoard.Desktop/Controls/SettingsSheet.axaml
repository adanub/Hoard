<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.Desktop.ViewModels"
             xmlns:ctrl="using:Hoard.Desktop.Controls"
             x:Class="Hoard.Desktop.Controls.SettingsSheet"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <!-- The Settings sheet (opened from the floating bar's ⚙, hosted in a shell-level SheetHost). Every
         change saves immediately — there's no Apply/Cancel; Done just closes. -->
    <StackPanel Margin="24" Spacing="16" MinWidth="340">
        <TextBlock Classes="h2" Text="Settings"/>

        <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="Theme"/>
            <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding ThemeChoice}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="Interface scale (text and controls)"/>
            <ComboBox ItemsSource="{Binding UiScaleChoices}" SelectedItem="{Binding UiScalePercent}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                        <TextBlock Text="{Binding StringFormat='{}{0}%'}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="Default cookies browser (for private boards)"/>
            <ComboBox ItemsSource="{Binding CookieBrowsers}" SelectedItem="{Binding DefaultCookiesBrowser}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Autoplay GIFs"/>
                <TextBlock Classes="muted" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"
                           Text="Play GIFs as they scroll into view. Memory stays capped by the limit below."/>
            </StackPanel>
            <ToggleButton Grid.Column="1" Theme="{StaticResource HoardSwitch}"
                          IsChecked="{Binding GifAutoplay}" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="Playing GIFs at once (the oldest stops beyond this)"/>
            <ComboBox ItemsSource="{Binding MaxPlayingGifsChoices}" SelectedItem="{Binding MaxPlayingGifs}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,2"/>

        <!-- Updates. Switches rather than checkboxes: booleans are switches throughout Hoard (DESIGN.md),
             and the theme has no CheckBox template — an unthemed stock control renders nothing. -->
        <StackPanel Spacing="12" IsVisible="{Binding HasUpdates}">
            <TextBlock Text="Updates"/>

            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowUpdateUnsupportedNote}"
                       FontSize="{DynamicResource FontSizeXs}"
                       Text="This copy of Hoard doesn't update itself — it was unzipped rather than installed. Download the latest release from GitHub to update."/>

            <StackPanel Spacing="12" IsVisible="{Binding ShowUpdateControls}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Check for updates automatically"/>
                        <TextBlock Classes="muted" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"
                                   Text="Look for a new version at startup. Hoard asks before installing anything."/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Theme="{StaticResource HoardSwitch}"
                                  IsChecked="{Binding AutoCheckUpdates}" VerticalAlignment="Center"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Install updates automatically"/>
                        <TextBlock Classes="muted" FontSize="{DynamicResource FontSizeXs}" TextWrapping="Wrap"
                                   Text="Download updates without asking and apply them the next time Hoard closes."/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Theme="{StaticResource HoardSwitch}"
                                  IsChecked="{Binding AutoInstallUpdates}" VerticalAlignment="Center"/>
                </Grid>

                <!-- ShowUpdateBusy = this sheet is open AND an update op is running. Not Update.IsBusy alone:
                     the shell's Settings SheetHost is always attached, so BusyBar (which keys off its OWN
                     IsVisible) would animate invisibly whenever a download runs with Settings closed. -->
                <ctrl:BusyBar IsVisible="{Binding ShowUpdateBusy}"/>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Update.SettingsStatusText}"
                           IsVisible="{Binding Update.SettingsStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <ctrl:FlexWrapPanel Spacing="8">
                    <Button Theme="{StaticResource HoardButton}" Classes="outline" Content="Check for updates"
                            Command="{Binding Update.CheckNowCommand}"/>
                    <Button Theme="{StaticResource HoardButton}" Content="Install update"
                            Command="{Binding Update.InstallCommand}"
                            IsVisible="{Binding Update.IsUpdateAvailable}"/>
                </ctrl:FlexWrapPanel>
            </StackPanel>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,2"/>

        <!-- About / diagnostics -->
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted" Text="Hoard"/>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding AppVersion}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted" Text="gallery-dl"/>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding GalleryDlVersion}"/>
            </Grid>
        </StackPanel>

        <ctrl:FlexWrapPanel Spacing="8">
            <Button Theme="{StaticResource HoardButton}" Classes="outline" Content="Open log folder"
                    Command="{Binding OpenLogsFolderCommand}"/>
            <Button Theme="{StaticResource HoardButton}" Classes="outline" Content="Open project folder"
                    Command="{Binding OpenProjectFolderCommand}" IsVisible="{Binding HasOpenProject}"/>
            <Button Theme="{StaticResource HoardButton}" Content="Done" Command="{Binding CloseCommand}"/>
        </ctrl:FlexWrapPanel>
    </StackPanel>
</UserControl>
