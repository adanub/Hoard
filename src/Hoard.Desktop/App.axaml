<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hoard.Desktop.App"
             xmlns:local="using:Hoard.Desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <!-- The Hoard design system IS the theme — no Fluent (or any base theme) underneath. Tokens +
             icons + component themes + the stock-control templates (Theme/Controls/Chrome, Scroll,
             ComboBox, ProgressBar) + the implicit by-type aliases. See DESIGN.md and Theme/Theme.axaml. -->
        <StyleInclude Source="avares://Hoard.Desktop/Theme/Theme.axaml"/>
    </Application.Styles>
</Application>