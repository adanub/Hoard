<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hoard.Desktop.App"
             xmlns:local="using:Hoard.Desktop"
             Name="Hoard"
             RequestedThemeVariant="Default">
             <!-- Name is NOT decoration: Avalonia's Application.Name defaults to the literal
                  "Avalonia Application", and the macOS backend pushes it into NSApplication
                  (Avalonia.Native's SetupApplicationName). That name is what the app menu, the Dock and
                  Activity Monitor show — so a correct Info.plist ISN'T enough on its own, and the shipped
                  1.1.0 bundle ran as "Avalonia Application" despite CFBundleName being "Hoard".
                  "Default" ThemeVariant follows the system theme variant. "Dark"/"Light" are the others. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <!-- The Hoard design system IS the theme — no Fluent (or any base theme) underneath. Tokens +
             icons + component themes + the stock-control templates (Theme/Controls/Chrome, Scroll,
             ComboBox, ProgressBar) + the implicit by-type aliases. See DESIGN.md and Theme/Theme.axaml. -->
        <StyleInclude Source="avares://Hoard/Theme/Theme.axaml"/>
    </Application.Styles>
</Application>