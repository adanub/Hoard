<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hoard.Desktop.App"
             xmlns:local="using:Hoard.Desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />

        <!-- Shared button classes (Fluent recolours the template's content presenter, so style that
             across every state rather than setting Background directly). -->

        <!-- Red destructive button. -->
        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A93226"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#7B241C"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <!-- Dark translucent overlay button (e.g. Unload) that stays visible in every state. -->
        <Style Selector="Button.overlay /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B0000000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.overlay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D8000000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.overlay:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Application.Styles>
</Application>