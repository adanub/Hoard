<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hoard.Desktop.Views.DeleteDialog"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Delete image">

    <StackPanel Margin="18" Spacing="12">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <TextBlock Text="Reason for deleting (required)" FontSize="11" Opacity="0.6"/>
        <TextBox Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                 MaxLength="500" PlaceholderText="e.g. duplicate, low quality, no longer wanted…"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancel"/>
            <Button Name="ConfirmButton" Content="Delete" Classes="danger" Click="OnConfirm" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
