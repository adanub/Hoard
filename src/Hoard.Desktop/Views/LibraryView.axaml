<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.Desktop.ViewModels"
             xmlns:ctrl="using:Hoard.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Hoard.Desktop.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Design.DataContext>
        <vm:LibraryViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- No top bar: the project name lives in the shell's breadcrumb strip, back/search/import in the
             floating bar. The grid owns the whole screen (the trailing margin keeps the last row clear of
             the floating bar). -->

        <!-- Board grid: "+ Import" + "All images" + one card per board, reflowing by width. ClipToBounds
             =False down to the item ContentPresenter so the raised cards' shadow + hover-scale aren't cropped
             to their cells (see the CLAUDE.md raised-card-in-grid rule). -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="36,28,36,96" ClipToBounds="False">
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                        <Setter Property="ClipToBounds" Value="False"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:NewBoardTile">
                        <ctrl:NewCard Label="Import" Margin="0,0,16,16"
                                      Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenImportSheetCommand}"/>
                    </DataTemplate>
                    <!-- IsVisible carries the floating bar's live board-name filter (hidden, not removed). -->
                    <DataTemplate DataType="vm:BoardCardRef">
                        <ctrl:BoardCard Margin="0,0,16,16" IsVisible="{Binding !IsFilteredOut}"
                                        Title="{Binding Name}" MetaText="{Binding MetaText}"
                                        Thumb0="{Binding Thumb0}" Thumb1="{Binding Thumb1}" Thumb2="{Binding Thumb2}"
                                        IsImporting="{Binding IsImporting}" ImportStatusText="{Binding ImportStatusText}"
                                        OpenCommand="{Binding OpenCommand}" EditCommand="{Binding EditCommand}"/>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- Import sheet: paste a Pinterest URL + pick cookies. (Target-board picker arrives with the board model.) -->
        <ctrl:SheetHost IsOpen="{Binding IsImportSheetOpen}" DismissCommand="{Binding CloseImportSheetCommand}">
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Classes="h2" Text="Import a board"/>
                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Pinterest board / section / pin URL"/>
                    <TextBox Theme="{StaticResource HoardInput}" Text="{Binding BoardUrl}"
                             PlaceholderText="pinterest.com/user/board…"/>
                </StackPanel>
                <!-- Import into a new board (created first) or an existing one (merge). -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Import into"/>
                    <ComboBox ItemsSource="{Binding ImportTargets}" SelectedItem="{Binding SelectedImportTarget}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportTarget">
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding IsNewBoardTarget}">
                    <TextBlock Classes="muted" Text="New board name"/>
                    <TextBox Theme="{StaticResource HoardInput}" Text="{Binding NewBoardName}"
                             PlaceholderText="Board name"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Cookies (for private boards)"/>
                    <ComboBox ItemsSource="{Binding CookieBrowsers}" SelectedItem="{Binding CookiesBrowser}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
                <ctrl:FlexWrapPanel Spacing="8">
                    <Button Theme="{StaticResource HoardButton}" Classes="ghost" Content="Cancel"
                            Command="{Binding CloseImportSheetCommand}"/>
                    <Button Theme="{StaticResource HoardButton}" Content="Import"
                            Command="{Binding ImportCommand}"/>
                </ctrl:FlexWrapPanel>
            </StackPanel>
        </ctrl:SheetHost>

        <!-- Board Edit popup (the pencil): rename / sources / info / clear cache / delete. Commands wired in
             code-behind (the delete routes through the confirm popup below). -->
        <ctrl:SheetHost x:Name="BoardEditHost" IsOpen="{Binding BoardEditor.IsSheetOpen}"
                        DismissCommand="{Binding BoardEditor.CloseCommand}">
            <ctrl:BoardEditSheet x:Name="BoardEditSheet"
                                 BoardName="{Binding BoardEditor.EditTarget.Name, Mode=OneWay}"
                                 SourceBoards="{Binding BoardEditor.EditTarget.Sources}"
                                 CountsText="{Binding BoardEditor.EditTarget.CountsText}"
                                 CacheText="{Binding BoardEditor.EditTarget.CacheText}"
                                 AddedText="{Binding BoardEditor.EditTarget.AddedText}"
                                 ImportedText="{Binding BoardEditor.EditTarget.ImportedText}"/>
        </ctrl:SheetHost>

        <!-- Shared confirm popup (the board delete), layered on top. -->
        <ctrl:SheetHost x:Name="BoardConfirmHost">
            <ctrl:ConfirmSheet x:Name="BoardConfirmContent"/>
        </ctrl:SheetHost>
    </Panel>
</UserControl>
