<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hoard.Desktop.Views.MessageDialog"
        Width="560" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="Message">

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Content="Copy" Click="OnCopy"/>
            <Button Content="Close" Classes="accent" Click="OnClose"/>
        </StackPanel>

        <TextBox Name="MessageText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas, monospace"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
