<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.Desktop.ViewModels"
             xmlns:ctrl="using:Hoard.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Hoard.Desktop.Views.BoardView"
             x:DataType="vm:BoardViewModel">

    <Design.DataContext>
        <vm:BoardViewModel/>
    </Design.DataContext>

    <!-- Esc is handled at the window (MainWindow) as a unified "back", not here — so it works regardless of focus
         and on every page; the band/zoom are navigation steps that Back/Esc step through. -->

    <!-- Panel so the Sync sheet overlays the whole screen. -->
    <Panel>
    <DockPanel>
        <!-- Top bar: back (← to Library) · board title · Sync (re-fetch the board's sources). -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Theme="{StaticResource HoardButton}" Classes="ghost"
                        Width="38" Height="38" Padding="0" Command="{Binding BackCommand}"
                        ToolTip.Tip="Back">
                    <ctrl:Icon Data="{StaticResource Icon.chevron-left}" Width="20" Height="20"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="h2" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Only a real board with at least one URL'd source can be synced; disabled while importing. -->
                <Button Grid.Column="2" Theme="{StaticResource HoardButton}" Classes="secondary"
                        Command="{Binding OpenSyncSheetCommand}"
                        IsVisible="{Binding IsSyncable}" IsEnabled="{Binding !IsBoardImporting}"
                        ToolTip.Tip="Re-fetch this board from its source(s)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctrl:Icon Data="{StaticResource Icon.rotate-ccw}" Width="16" Height="16"/>
                        <TextBlock Text="Sync" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Import strip: shown while an import is landing in this board, with the same live count as the card. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsBoardImporting}" Padding="16,8"
                Background="{DynamicResource SecondaryGradientBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <TextBlock Classes="accent" FontSize="{DynamicResource FontSizeSm}" Text="{Binding ImportStatusText}"/>
                <!-- Own IsVisible carries the gate (not just the strip Border's) — the BusyBar contract. -->
                <ctrl:BusyBar Height="4" IsVisible="{Binding IsBoardImporting}"
                              Foreground="{DynamicResource PrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Grid: child folders (as board cards, like the Library) sorted BEFORE the images, both in one scroll
             with a floating detail overlay on top. The masonry stays virtualized (its layout realizes from the
             effective viewport, not the measure height), so a folder header above it is free. -->
        <Panel>
            <!-- Horizontal inset is a Margin on the content, NOT ScrollViewer.Padding. The masonry fills its width
                 edge-to-edge, and SV horizontal padding cropped the right edge (the scrollbar/padding placement ate
                 it — the measured width was already correct, so it wasn't an overflow). A content Margin gives a
                 reliable, symmetric left/right inset. Vertical padding stays on the SV (its scroll-direction padding
                 behaves, and the scroll-to-top math reads GridScroll.Padding.Top). -->
            <ScrollViewer Name="GridScroll" Padding="0,10"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6" Margin="10,0" ClipToBounds="False">
                    <!-- Folder grid: "+ New folder" + one BoardCard per child folder, rendered exactly like
                         top-level boards. Hidden for "All images" / search results. ClipToBounds=False down to
                         the item ContentPresenter so the cards' hover-scale + shadow aren't cropped (the same
                         raised-card-in-grid rule as the Library). -->
                    <ItemsControl ItemsSource="{Binding FolderTiles}" IsVisible="{Binding ShowFolderRow}"
                                  Margin="6,4,6,8" ClipToBounds="False">
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter">
                                <Setter Property="ClipToBounds" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ClipToBounds="False"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:NewFolderTile">
                                <ctrl:NewCard Label="New folder" Margin="0,0,16,16"
                                              Command="{Binding $parent[ItemsControl].((vm:BoardViewModel)DataContext).OpenNewFolderSheetCommand}"/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:BoardCardRef">
                                <ctrl:BoardCard Margin="0,0,16,16"
                                                Title="{Binding Name}" MetaText="{Binding MetaText}"
                                                Thumb0="{Binding Thumb0}" Thumb1="{Binding Thumb1}" Thumb2="{Binding Thumb2}"
                                                OpenCommand="{Binding OpenCommand}" EditCommand="{Binding EditCommand}"/>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <!-- ClipToBounds=False so an ItemCard's hover-scale + lifted shadow aren't cropped to its cell. -->
                    <ItemsRepeater Name="AssetGrid" ItemsSource="{Binding Assets}" ClipToBounds="False">
                        <ItemsRepeater.Layout>
                            <ctrl:MasonryLayout TargetColumnWidth="200" Spacing="10"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AssetTileViewModel">
                                <!-- Dual-mode item: the masonry tile when collapsed, a full-width inline detail
                                     band when this tile is expanded (the layout sizes the item to the band rect). -->
                                <Panel x:Name="ItemRoot" ClipToBounds="False">
                                    <ctrl:ItemCard IsVisible="{Binding !IsExpanded}"
                                                   Thumbnail="{Binding Thumbnail}" PlaySource="{Binding PlaySource}"
                                                   IsImage="{Binding IsImage}" KindLabel="{Binding KindLabel}"
                                                   ShowGifTag="{Binding IsGifBadgeVisible}"
                                                   IsDeleted="{Binding IsDeleted}" DeletionNote="{Binding DeletionNote}"
                                                   IsThumbnailLoading="{Binding IsThumbnailLoading}"
                                                   IsFileMissing="{Binding IsFileMissing}" IsRefetching="{Binding IsRefetching}"
                                                   OpenCommand="{Binding OpenCommand}" UnloadCommand="{Binding UnloadCommand}"
                                                   RefetchCommand="{Binding RefetchCommand}"/>

                                    <!-- Lazy inline detail band: built ONLY for the expanded tile. The ContentControl
                                         instantiates its ContentTemplate only when Content (BandContent) is non-null —
                                         true solely for the expanded tile — so collapsed and recycled/retained tiles
                                         never carry the heavy band markup (rail, actions, media). That per-tile band
                                         was the bulk of a leaked view's memory. Opacity is the BandContentOpacity the
                                         view drives (0 while the masonry reflows, 1 once it settles); the transition
                                         fades it in after the tiles move. The inner panel's DataContext is the
                                         AssetDetailViewModel; the band root (#BandRoot) keeps the tile DataContext. -->
                                    <ContentControl Content="{Binding BandContent}">
                                      <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:AssetTileViewModel">
                                    <Border x:Name="BandRoot" Opacity="{Binding BandContentOpacity}"
                                            CornerRadius="{DynamicResource RadiusMd}"
                                            Background="{DynamicResource PopoverBrush}" ClipToBounds="True"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                            BoxShadow="{DynamicResource ShadowMd}">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <!-- Responsive band: the info rail sits BESIDE the image when wide, and BELOW it
                                             (capped, scrolling) when the band is narrower than the stack breakpoint. Both
                                             states come from styles (a local Dock/Width would beat the style — the
                                             CLAUDE.md "local value vs style" trap), keyed off the bandstacked class the
                                             view toggles. The rail width + the stacked info height are the packer's own
                                             constants, so the visual layout matches the band-height math. -->
                                        <DockPanel x:Name="BandPanel"
                                                   DataContext="{Binding $parent[UserControl].((vm:BoardViewModel)DataContext).Details}"
                                                   x:DataType="vm:AssetDetailViewModel"
                                                   Classes.bandstacked="{Binding $parent[UserControl].((vm:BoardViewModel)DataContext).IsBandStacked}">
                                            <DockPanel.Styles>
                                                <Style Selector="DockPanel#BandPanel &gt; DockPanel#Rail">
                                                    <Setter Property="DockPanel.Dock" Value="Right"/>
                                                    <Setter Property="Width" Value="{x:Static ctrl:MasonryLayout.RailWidth}"/>
                                                </Style>
                                                <Style Selector="DockPanel#BandPanel.bandstacked &gt; DockPanel#Rail">
                                                    <Setter Property="DockPanel.Dock" Value="Bottom"/>
                                                    <Setter Property="Width" Value="NaN"/>
                                                    <Setter Property="MaxHeight" Value="{x:Static ctrl:MasonryPacker.StackInfoHeight}"/>
                                                </Style>
                                            </DockPanel.Styles>

                                            <!-- Info + actions rail (docked right/bottom per the styles above) -->
                                            <DockPanel x:Name="Rail" Background="{DynamicResource PopoverBrush}">
                                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12,10,6">
                                                    <TextBlock Text="Details" Classes="h2" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Theme="{StaticResource HoardButton}" Classes="ghost"
                                                            Width="34" Height="34" Padding="0" ToolTip.Tip="Close (Esc)"
                                                            Command="{Binding $parent[UserControl].((vm:BoardViewModel)DataContext).CloseDetailsCommand}">
                                                        <ctrl:Icon Data="{StaticResource Icon.x}" Width="16" Height="16"/>
                                                    </Button>
                                                </Grid>
                                                <ScrollViewer>
                                                    <StackPanel Margin="16,0,16,16" Spacing="10">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <StackPanel Spacing="8" Margin="0,4,0,0">
                                                            <StackPanel IsVisible="{Binding Dimensions, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <TextBlock Text="Dimensions" Classes="muted" FontSize="11"/>
                                                                <TextBlock Text="{Binding Dimensions}"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="File size" Classes="muted" FontSize="11"/>
                                                                <TextBlock Text="{Binding FileSize}"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="Type" Classes="muted" FontSize="11"/>
                                                                <TextBlock Text="{Binding TypeText}"/>
                                                            </StackPanel>
                                                            <StackPanel IsVisible="{Binding Boards, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <TextBlock Text="Boards" Classes="muted" FontSize="11"/>
                                                                <TextBlock Text="{Binding Boards}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                                            <Button Theme="{StaticResource HoardButton}" Classes="secondary" Content="Open source on Pinterest"
                                                                    HorizontalAlignment="Stretch" Click="OnOpenSource"
                                                                    IsVisible="{Binding SourceUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            <Button Theme="{StaticResource HoardButton}" Classes="secondary" Content="Open file"
                                                                    HorizontalAlignment="Stretch" Click="OnOpenImage" IsVisible="{Binding IsLive}"/>
                                                            <Button Theme="{StaticResource HoardButton}" Classes="secondary" Content="Move to folder…"
                                                                    HorizontalAlignment="Stretch" Click="OnMoveAsset"
                                                                    IsVisible="{Binding $parent[UserControl].((vm:BoardViewModel)DataContext).CanMoveSelected}"/>
                                                            <Button Theme="{StaticResource HoardButton}" Content="♻ Restore from source"
                                                                    HorizontalAlignment="Stretch" Click="OnRestoreAsset" Margin="0,8,0,0"
                                                                    IsVisible="{Binding IsDeleted}" IsEnabled="{Binding CanRestore}"/>
                                                            <Button Theme="{StaticResource HoardButton}" Classes="destructive" Content="Delete from archive"
                                                                    HorizontalAlignment="Stretch" Click="OnDeleteAsset" Margin="0,8,0,0"
                                                                    IsVisible="{Binding IsLive}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </DockPanel>

                                            <!-- Big media — the DockPanel's fill (LastChildFill), so it takes the
                                                 space the rail doesn't (left of it when wide, above it when stacked).
                                                 Tapping it opens the fullscreen zoom/pan lightbox (a no-op for
                                                 video/tombstones — OpenLightbox gates on a live image). -->
                                            <Panel Background="{DynamicResource MutedBrush}" Cursor="Hand"
                                                   PointerPressed="OnBandMediaPressed" Tapped="OnBandMediaTapped">
                                                <Image Source="{Binding Preview}" Stretch="Uniform" Margin="6"
                                                       IsVisible="{Binding IsStaticImage}"/>
                                                <!-- Source is gated on the TILE's IsExpanded (via BandPlaySource), so the
                                                     GIF only decodes/plays in the one expanded tile, not in every realized
                                                     band (AnimatedImageControl loads on Source regardless of visibility). -->
                                                <ctrl:AnimatedImageControl Name="BandGif" Margin="6" IsVisible="{Binding IsGif}"
                                                                           Source="{Binding #BandRoot.((vm:AssetTileViewModel)DataContext).BandPlaySource}"/>
                                                <TextBlock Text="🎬  Video — use “Open file” to play" IsVisible="{Binding IsVideo}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                <StackPanel IsVisible="{Binding IsDeleted}" Spacing="6"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🗑  Deleted" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DeletionNote}" TextWrapping="Wrap" MaxWidth="360"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                                </StackPanel>
                                                <ctrl:BusyBar Width="120" Height="4"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsVisible="{Binding IsPreviewLoading}"/>
                                                <ctrl:BusyBar Width="120" Height="4"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsVisible="{Binding #BandGif.IsLoading}"/>
                                                <!-- Shown while Details itself is loading (DataContext here is null then,
                                                     so this binds the board VM directly, not Details). Only renders for
                                                     the expanded tile, since the whole band is IsVisible=IsExpanded. -->
                                                <ctrl:BusyBar Width="120" Height="4"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsVisible="{Binding $parent[UserControl].((vm:BoardViewModel)DataContext).IsDetailLoading}"/>
                                            </Panel>
                                        </DockPanel>
                                    </Border>
                                        </DataTemplate>
                                      </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </Panel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>

        </Panel>
    </DockPanel>

        <!-- Sync sheet: pick cookies (for private boards), then re-fetch every source of this board. -->
        <ctrl:SheetHost IsOpen="{Binding IsSyncSheetOpen}" DismissCommand="{Binding CloseSyncSheetCommand}">
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Classes="h2" Text="Sync this board"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Re-fetch this board from its source board(s): pulls in anything missing or newly added, and skips items you've deleted."/>
                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Cookies (for private boards)"/>
                    <ComboBox ItemsSource="{Binding CookieBrowsers}" SelectedItem="{Binding SyncCookiesBrowser}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
                <ctrl:FlexWrapPanel Spacing="8">
                    <Button Theme="{StaticResource HoardButton}" Classes="ghost" Content="Cancel"
                            Command="{Binding CloseSyncSheetCommand}"/>
                    <Button Theme="{StaticResource HoardButton}" Content="{Binding SyncButtonText}"
                            Command="{Binding SyncCommand}"/>
                </ctrl:FlexWrapPanel>
            </StackPanel>
        </ctrl:SheetHost>

        <!-- New-folder sheet: name a sub-folder to create in this board. -->
        <ctrl:SheetHost IsOpen="{Binding IsNewFolderSheetOpen}" DismissCommand="{Binding CloseNewFolderSheetCommand}">
            <StackPanel Margin="24" Spacing="16" Width="360">
                <TextBlock Classes="h2" Text="New folder"/>
                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Folder name"/>
                    <TextBox Theme="{StaticResource HoardInput}" Text="{Binding NewFolderName}" PlaceholderText="e.g. Kitchen"/>
                </StackPanel>
                <ctrl:FlexWrapPanel Spacing="8">
                    <Button Theme="{StaticResource HoardButton}" Classes="ghost" Content="Cancel"
                            Command="{Binding CloseNewFolderSheetCommand}"/>
                    <Button Theme="{StaticResource HoardButton}" Content="Create folder"
                            Command="{Binding CreateFolderCommand}"/>
                </ctrl:FlexWrapPanel>
            </StackPanel>
        </ctrl:SheetHost>

        <!-- Move sheet: pick where to file the selected pin (a folder, or "out" to the parent board). -->
        <ctrl:SheetHost IsOpen="{Binding IsMoveSheetOpen}" DismissCommand="{Binding CloseMoveSheetCommand}">
            <StackPanel Margin="24" Spacing="16" Width="360">
                <TextBlock Classes="h2" Text="Move to folder"/>
                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Destination"/>
                    <ComboBox ItemsSource="{Binding MoveTargets}" SelectedItem="{Binding SelectedMoveTarget}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MoveTarget">
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <ctrl:FlexWrapPanel Spacing="8">
                    <Button Theme="{StaticResource HoardButton}" Classes="ghost" Content="Cancel"
                            Command="{Binding CloseMoveSheetCommand}"/>
                    <Button Theme="{StaticResource HoardButton}" Content="Move"
                            Command="{Binding ConfirmMoveCommand}"/>
                </ctrl:FlexWrapPanel>
            </StackPanel>
        </ctrl:SheetHost>

        <!-- Folder Edit popup (a folder card's pencil): rename / clear cache / delete. No source list (folders
             have no sources). Bound to the folder card under edit; commands wired in code-behind, delete routes
             through the confirm. -->
        <ctrl:SheetHost x:Name="FolderEditHost" IsOpen="{Binding FolderEditor.IsSheetOpen}"
                        DismissCommand="{Binding FolderEditor.CloseCommand}">
            <ctrl:BoardEditSheet x:Name="FolderEditSheet"
                                 Heading="Edit folder" DeleteLabel="Delete folder…" ShowSources="False"
                                 BoardName="{Binding FolderEditor.EditTarget.Name, Mode=OneWay}"
                                 CountsText="{Binding FolderEditor.EditTarget.CountsText}"
                                 CacheText="{Binding FolderEditor.EditTarget.CacheText}"
                                 AddedText="{Binding FolderEditor.EditTarget.AddedText}"/>
        </ctrl:SheetHost>

        <!-- Shared confirm popup (the folder delete), layered on top. -->
        <ctrl:SheetHost x:Name="FolderConfirmHost">
            <ctrl:ConfirmSheet x:Name="FolderConfirmContent"/>
        </ctrl:SheetHost>

        <!-- Delete sheet: collect the required tombstone reason, then delete (the in-app replacement for the old
             DeleteDialog window). The image file is recycled but the row is kept as a restorable tombstone. -->
        <ctrl:SheetHost IsOpen="{Binding IsDeleteSheetOpen}" DismissCommand="{Binding CloseDeleteSheetCommand}">
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Classes="h2" Text="Delete image"/>
                <TextBlock Text="{Binding DeleteTargetTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="The image file is removed from disk, but it's kept as a tombstone (showing your reason) and can be restored from its source later."/>
                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Reason for deleting (required)"/>
                    <TextBox Theme="{StaticResource HoardInput}" Text="{Binding DeleteNote}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxLength="500"
                             PlaceholderText="e.g. duplicate, low quality, no longer wanted…"/>
                </StackPanel>
                <ctrl:FlexWrapPanel Spacing="8">
                    <Button Theme="{StaticResource HoardButton}" Classes="ghost" Content="Cancel"
                            Command="{Binding CloseDeleteSheetCommand}"/>
                    <Button Theme="{StaticResource HoardButton}" Classes="destructive" Content="Delete"
                            Command="{Binding ConfirmDeleteCommand}" IsEnabled="{Binding CanConfirmDelete}"/>
                </ctrl:FlexWrapPanel>
            </StackPanel>
        </ctrl:SheetHost>

        <!-- Fullscreen zoom/pan viewer for the expanded image, layered above everything (last child = topmost). -->
        <ctrl:Lightbox IsOpen="{Binding IsLightboxOpen}" Source="{Binding LightboxSource}"
                       IsGif="{Binding LightboxIsGif}" CloseCommand="{Binding CloseLightboxCommand}"/>
    </Panel>
</UserControl>
