<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Hoard.Desktop.Views.ProjectLauncherView"
             x:DataType="vm:ProjectLauncherViewModel">

    <Design.DataContext>
        <vm:ProjectLauncherViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" MaxWidth="820" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,12,0,18">
            <TextBlock Text="Hoard" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Open a project, or create one to start archiving." Opacity="0.7"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,24,*">
            <!-- Recent projects -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Recent projects" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Open existing folder…" Click="OnOpenExisting"/>
                    <Button Content="Clear cache" Command="{Binding ClearCacheCommand}"/>
                    <Button Content="Remove from list" Command="{Binding ForgetCommand}"/>
                    <Button Content="Delete from disk…" Click="OnDeleteFromDisk"
                            IsEnabled="{Binding SelectedRecent, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" CornerRadius="6">
                    <Panel>
                        <TextBlock Text="No recent projects yet." Opacity="0.5" Margin="12"
                                   IsVisible="{Binding !HasRecents}"/>
                        <ListBox ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedRecent}"
                                 DoubleTapped="OnRecentDoubleTapped" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentProjectRef">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" Opacity="0.55" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CacheSizeText}" Opacity="0.45" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </Border>
            </DockPanel>

            <!-- New project -->
            <StackPanel Grid.Column="2" Spacing="8">
                <TextBlock Text="New project" FontWeight="SemiBold"/>
                <TextBlock Text="Name" Opacity="0.7" Margin="0,4,0,0"/>
                <TextBox Text="{Binding NewProjectName}" PlaceholderText="e.g. Pinterest Archive"/>
                <TextBlock Text="{Binding NameError}" Foreground="#E06C75" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding HasNameError}"/>
                <TextBlock Text="Location" Opacity="0.7" Margin="0,4,0,0"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding NewProjectLocation}" IsReadOnly="True"
                             PlaceholderText="Choose a parent folder…"/>
                    <Button Grid.Column="1" Content="Browse…" Click="OnBrowseLocation"/>
                </Grid>
                <TextBlock Text="{Binding NewProjectPreviewPath}" Opacity="0.55" FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="{Binding NewProjectPreviewPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Button Content="Create project" Classes="accent" HorizontalAlignment="Left"
                        Margin="0,4,0,0" Command="{Binding CreateProjectCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Footer / status -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Open project" Classes="accent"
                    Command="{Binding OpenRecentCommand}"/>
        </Grid>
    </Grid>
</UserControl>
