<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hoard.Desktop.ViewModels"
             xmlns:ctrl="using:Hoard.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Hoard.Desktop.Views.ProjectLauncherView"
             x:DataType="vm:ProjectLauncherViewModel">

    <Design.DataContext>
        <vm:ProjectLauncherViewModel/>
    </Design.DataContext>

    <!-- Panel so the new-project sheet overlays the whole screen. -->
    <Panel>
        <!-- No page heading — the shell's breadcrumb already says "Projects". -->
        <ScrollViewer>
            <!-- No MaxWidth cap: the card rows fill the window width (FillWrapPanel), like every other grid. -->
            <StackPanel Margin="36,28,36,96" Spacing="20">
                <!-- The “+ New project” tile + one card per recent project, reflowing by width. ClipToBounds
                     =False all the way down (incl. the item ContentPresenter) so the raised cards' drop shadow
                     and hover-scale aren't cropped to their cells — see the CLAUDE.md raised-card-in-grid rule. -->
                <ItemsControl ItemsSource="{Binding Tiles}" ClipToBounds="False">
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                            <Setter Property="ClipToBounds" Value="False"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Rows fill the width (leftover < one card is absorbed by stretching); the
                                 panel owns the 16px gutters, so items carry no spacing margins. -->
                            <ctrl:FillWrapPanel ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>

                        <!-- Leading action tile: the raised "+ New project" card (NewProjectCard), sized to the
                             project card's footprint. Its command opens the new-project sheet. -->
                        <DataTemplate DataType="vm:NewProjectTile">
                            <ctrl:NewProjectCard Label="New project"
                                                 Command="{Binding $parent[ItemsControl].((vm:ProjectLauncherViewModel)DataContext).OpenNewProjectSheetCommand}"/>
                        </DataTemplate>

                        <!-- Project card (inset): collage cover + name + cache, with Open + Edit (pencil) buttons.
                             Open/Edit are per-item commands on the ref; Edit opens the popup below. IsVisible
                             carries the floating bar's live filter (hidden, not removed — no bitmap churn). -->
                        <DataTemplate DataType="vm:RecentProjectRef">
                            <ctrl:ProjectCard IsVisible="{Binding !IsFilteredOut}"
                                              Title="{Binding Name}" MetaText="{Binding CacheSizeText}"
                                              Thumb0="{Binding Thumb0}" Thumb1="{Binding Thumb1}" Thumb2="{Binding Thumb2}"
                                              OpenCommand="{Binding OpenCommand}" EditCommand="{Binding EditCommand}"/>
                        </DataTemplate>

                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- New-project sheet: create a project, or adopt an existing folder. -->
        <ctrl:SheetHost IsOpen="{Binding IsNewProjectSheetOpen}" DismissCommand="{Binding CloseNewProjectSheetCommand}">
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Classes="h2" Text="New project"/>

                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Name"/>
                    <TextBox Theme="{StaticResource HoardInput}"
                             Text="{Binding NewProjectName}" PlaceholderText="e.g. Pinterest Archive"/>
                    <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DestructiveBrush}"
                               FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasNameError}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Location"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Theme="{StaticResource HoardInput}"
                                 Text="{Binding NewProjectLocation}" IsReadOnly="True"
                                 PlaceholderText="Choose a parent folder…"/>
                        <Button Grid.Column="1" Theme="{StaticResource HoardButton}" Classes="secondary"
                                Content="Browse…" Click="OnBrowseLocation"/>
                    </Grid>
                    <TextBlock Text="{Binding NewProjectPreviewPath}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding NewProjectPreviewPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <TextBlock Text="{Binding SheetError}" Foreground="{DynamicResource DestructiveBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding SheetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Theme="{StaticResource HoardButton}" Classes="ghost" Content="Cancel"
                            Command="{Binding CloseNewProjectSheetCommand}"/>
                    <Button Theme="{StaticResource HoardButton}" Content="Create project"
                            Command="{Binding CreateProjectCommand}"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,2"/>
                <TextBlock Classes="muted" Text="Already have a project folder?" HorizontalAlignment="Center"/>
                <Button Theme="{StaticResource HoardButton}" Classes="outline" Content="Open existing folder…"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnOpenExisting"/>
            </StackPanel>
        </ctrl:SheetHost>

        <!-- Edit popup for a project (rename / info / clear cache / remove / delete). Its action commands are
             wired in code-behind (the delete routes through the confirm popup below). -->
        <ctrl:SheetHost x:Name="EditHost" IsOpen="{Binding IsEditSheetOpen}" DismissCommand="{Binding CloseEditSheetCommand}">
            <ctrl:ProjectEditSheet x:Name="EditSheet"
                                   ProjectName="{Binding EditTarget.Name, Mode=OneWay}"
                                   FolderPath="{Binding EditTarget.Path}"
                                   CountsText="{Binding EditTarget.CountsText}"
                                   BoardsText="{Binding EditTarget.BoardsText}"
                                   CacheText="{Binding EditTarget.CacheSizeText}"
                                   OnDiskText="{Binding EditTarget.OnDiskText}"
                                   AddedText="{Binding EditTarget.AddedText}"
                                   ModifiedText="{Binding EditTarget.ModifiedText}"
                                   VerifyText="{Binding EditTarget.VerifyText}"/>
        </ctrl:SheetHost>

        <!-- Shared confirm popup (the project delete), layered on top of the Edit popup. -->
        <ctrl:SheetHost x:Name="ConfirmHost">
            <ctrl:ConfirmSheet x:Name="ConfirmContent"/>
        </ctrl:SheetHost>

        <!-- Busy overlay: while a project's DB opens/builds off the UI thread (the EF model compiles on first
             use), dim the screen and show an indeterminate bar instead of letting the shell freeze. The scrim
             also blocks clicks on the cards underneath. -->
        <Border IsVisible="{Binding IsOpening}" Background="{DynamicResource ScrimBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Padding="28,24"
                    Background="{DynamicResource PopoverBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}"
                    BoxShadow="{DynamicResource ShadowMd}">
                <StackPanel Spacing="14" MinWidth="240">
                    <!-- Own IsVisible carries the gate (not just the ancestor overlay's) so the BusyBar's
                         animation actually stops when the overlay hides — the BusyBar contract. -->
                    <ctrl:BusyBar Height="6" IsVisible="{Binding IsOpening}"/>
                    <TextBlock Text="{Binding OpeningText}" Classes="muted" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
