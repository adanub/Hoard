<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:Hoard.Desktop.Controls"
        xmlns:inf="using:Hoard.Desktop.Infrastructure"
        x:Class="Hoard.Desktop.Views.GalleryWindow"
        Width="760" Height="900"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource BackgroundBrush}"
        Title="Hoard — component gallery">

    <Panel>
    <DockPanel inf:FocusManagement.ClearFocusOnPointerPressed="True"
               TextElement.Foreground="{DynamicResource ForegroundBrush}">
        <!-- Header + theme toggle -->
        <Border DockPanel.Dock="Top" Padding="24,18" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="h1" Text="Component gallery" VerticalAlignment="Center"/>
                <!-- Theme switch: sun (off/light) ─ switch ─ moon (on/dark); wired via OnThemeToggle. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ctrl:Icon Data="{StaticResource Icon.sun}" Width="18" Height="18" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <ToggleButton Theme="{StaticResource HoardSwitch}" IsChecked="True" IsCheckedChanged="OnThemeToggle"/>
                    <ctrl:Icon Data="{StaticResource Icon.moon}" Width="18" Height="18" Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="28" MaxWidth="700" HorizontalAlignment="Left">

                <!-- Buttons: one row per size, each showing every variant (+ disabled) — full matrix. -->
                <StackPanel Spacing="8">
                    <StackPanel.Styles>
                        <Style Selector="Button"><Setter Property="Margin" Value="0,0,8,8"/></Style>
                    </StackPanel.Styles>
                    <TextBlock Classes="h2" Text="Buttons"/>

                    <TextBlock Classes="muted" Text="Large (lg)"/>
                    <WrapPanel>
                        <Button Theme="{StaticResource HoardButton}" Classes="lg" Content="Primary"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="secondary lg" Content="Secondary"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="outline lg" Content="Outline"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="ghost lg" Content="Ghost"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="destructive lg" Content="Destructive"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="lg" IsEnabled="False" Content="Disabled"/>
                    </WrapPanel>

                    <TextBlock Classes="muted" Text="Default"/>
                    <WrapPanel>
                        <Button Theme="{StaticResource HoardButton}" Content="Primary"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="secondary" Content="Secondary"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="outline" Content="Outline"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="ghost" Content="Ghost"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="destructive" Content="Destructive"/>
                        <Button Theme="{StaticResource HoardButton}" IsEnabled="False" Content="Disabled"/>
                    </WrapPanel>

                    <TextBlock Classes="muted" Text="Small (sm)"/>
                    <WrapPanel>
                        <Button Theme="{StaticResource HoardButton}" Classes="sm" Content="Primary"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="secondary sm" Content="Secondary"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="outline sm" Content="Outline"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="ghost sm" Content="Ghost"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="destructive sm" Content="Destructive"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="sm" IsEnabled="False" Content="Disabled"/>
                    </WrapPanel>

                    <TextBlock Classes="muted" Text="Icon"/>
                    <WrapPanel>
                        <WrapPanel.Styles>
                            <Style Selector="ctrl|Icon"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/></Style>
                        </WrapPanel.Styles>
                        <Button Theme="{StaticResource HoardButton}" Classes="icon">
                            <ctrl:Icon Data="{StaticResource Icon.plus}" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Button>
                        <Button Theme="{StaticResource HoardButton}" Classes="secondary icon">
                            <ctrl:Icon Data="{StaticResource Icon.search}"/>
                        </Button>
                        <Button Theme="{StaticResource HoardButton}" Classes="outline icon">
                            <ctrl:Icon Data="{StaticResource Icon.folder}"/>
                        </Button>
                        <Button Theme="{StaticResource HoardButton}" Classes="ghost icon">
                            <ctrl:Icon Data="{StaticResource Icon.image}"/>
                        </Button>
                        <Button Theme="{StaticResource HoardButton}" Classes="destructive icon">
                            <ctrl:Icon Data="{StaticResource Icon.trash-2}" Foreground="{DynamicResource DestructiveForegroundBrush}"/>
                        </Button>
                        <Button Theme="{StaticResource HoardButton}" Classes="icon" IsEnabled="False">
                            <ctrl:Icon Data="{StaticResource Icon.plus}" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Switch: real on/off toggle — knob slides + track recolours -->
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="Switch"/>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <ToggleButton Theme="{StaticResource HoardSwitch}"/>
                        <ToggleButton Theme="{StaticResource HoardSwitch}" IsChecked="True"/>
                        <ToggleButton Theme="{StaticResource HoardSwitch}" IsEnabled="False"/>
                        <ToggleButton Theme="{StaticResource HoardSwitch}" IsChecked="True" IsEnabled="False"/>
                    </StackPanel>
                    <!-- As used: switch + a label beside it. -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ToggleButton Theme="{StaticResource HoardSwitch}" IsChecked="True"/>
                        <TextBlock Text="Dark mode" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Project card: 3-up collage cover + name + metadata + Open/Edit (both lg) -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Project card"/>
                    <ctrl:ProjectCard x:Name="DemoProjectCard" Title="HoardTest1"
                                      MetaText="78 images · 12 MB cache" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Board card: collage + name + metadata, no Open button (card body opens), floating pencil -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Board card"/>
                    <ctrl:BoardCard x:Name="DemoBoardCard"
                                    Title="animation-references-and-other-very-long-board-name"
                                    MetaText="37 images · 5 MB cache" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Sheet (in-app modal) -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Sheet"/>
                    <Button Theme="{StaticResource HoardButton}" Content="Open sheet" HorizontalAlignment="Left" Click="OnOpenSheet"/>
                </StackPanel>

                <!-- Toast (transient messages) -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Toast"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Theme="{StaticResource HoardButton}" Classes="secondary" Content="Show toast" Click="OnShowToast"/>
                        <Button Theme="{StaticResource HoardButton}" Classes="destructive" Content="Show error toast" Click="OnShowErrorToast"/>
                    </StackPanel>
                </StackPanel>

                <!-- Input -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Input"/>
                    <TextBox Theme="{StaticResource HoardInput}" Width="320" HorizontalAlignment="Left"
                             Text="Select this text to test the highlight"/>
                    <TextBox Theme="{StaticResource HoardInput}" Width="320" HorizontalAlignment="Left" Margin="0,8,0,0"
                             PlaceholderText="Search title, description…"/>
                </StackPanel>

                <!-- Rows — a real selectable, keyboard-navigable ListBox (hover / press / selected states). -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Rows"/>
                    <ListBox ItemContainerTheme="{StaticResource HoardListItem}" SelectedIndex="0"
                             MaxWidth="360" HorizontalAlignment="Left"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBoxItem>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ctrl:Icon Grid.Column="0" Data="{StaticResource Icon.folder}" Width="18" Height="18" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="Favourites" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="badge"><TextBlock Classes="muted" Text="12"/></Border>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ctrl:Icon Grid.Column="0" Data="{StaticResource Icon.folder}" Width="18" Height="18" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="animation-references" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="badge"><TextBlock Classes="muted" Text="37"/></Border>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ctrl:Icon Grid.Column="0" Data="{StaticResource Icon.image}" Width="18" Height="18" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="All images" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="badge"><TextBlock Classes="muted" Text="78"/></Border>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <!-- Icons -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Icons (Lucide)"/>
                    <WrapPanel>
                        <WrapPanel.Styles>
                            <Style Selector="ctrl|Icon"><Setter Property="Margin" Value="0,0,16,12"/></Style>
                        </WrapPanel.Styles>
                        <ctrl:Icon Data="{StaticResource Icon.chevron-left}"/>
                        <ctrl:Icon Data="{StaticResource Icon.plus}"/>
                        <ctrl:Icon Data="{StaticResource Icon.search}"/>
                        <ctrl:Icon Data="{StaticResource Icon.x}"/>
                        <ctrl:Icon Data="{StaticResource Icon.trash-2}"/>
                        <ctrl:Icon Data="{StaticResource Icon.rotate-ccw}"/>
                        <ctrl:Icon Data="{StaticResource Icon.image}"/>
                        <ctrl:Icon Data="{StaticResource Icon.folder}"/>
                        <ctrl:Icon Data="{StaticResource Icon.more-horizontal}"/>
                        <ctrl:Icon Data="{StaticResource Icon.download}"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Colour tokens -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Colour tokens"/>
                    <WrapPanel>
                        <WrapPanel.Styles>
                            <Style Selector="Border.swatch">
                                <Setter Property="Width" Value="96"/>
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Margin" Value="0,0,8,8"/>
                            </Style>
                        </WrapPanel.Styles>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource CardBrush}"/><TextBlock Classes="muted" Text="card"/></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource MutedBrush}"/><TextBlock Classes="muted" Text="muted"/></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource PrimaryBrush}"/><TextBlock Classes="muted" Text="accent"/></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource AccentBrush}"/><TextBlock Classes="muted" Text="accent tint"/></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource DestructiveBrush}"/><TextBlock Classes="muted" Text="destructive"/></StackPanel>
                    </WrapPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

        <!-- Overlays for the Sheet + Toast demos (sit above everything). -->
        <ctrl:SheetHost x:Name="DemoSheet">
            <StackPanel Margin="24" Spacing="14">
                <TextBlock Classes="h2" Text="Example sheet"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="A modal sheet: the scrim dims the screen and the card floats above it. Click the scrim or press Esc to dismiss."/>
                <Button Theme="{StaticResource HoardButton}" Content="Close" HorizontalAlignment="Right" Click="OnCloseSheet"/>
            </StackPanel>
        </ctrl:SheetHost>
        <ctrl:ToastHost x:Name="DemoToasts"/>

        <!-- Project card's Edit popup (opened by the card's Edit button). -->
        <ctrl:SheetHost x:Name="ProjectEditDemoSheet">
            <ctrl:ProjectEditSheet ProjectName="HoardTest1"
                                   FolderPath="D:\Archive\HoardTest1"
                                   CountsText="Images 64   ·   GIFs 9   ·   Videos 5"
                                   BoardsText="Boards 4"
                                   CacheText="Cache 12 MB" OnDiskText="On disk 318 MB"
                                   AddedText="Added 2026-05-01" ModifiedText="Modified 2026-06-17"/>
        </ctrl:SheetHost>
    </Panel>
</Window>
