<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hoard.Desktop.ViewModels"
        xmlns:ctrl="using:Hoard.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Hoard.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Assets/hoard.ico"
        Title="Hoard — Pinterest archive" Width="1100" Height="700">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Fluid reflow (Pinterest-style): pages lay out in real pixels and scroll naturally; the masonry grid
         gains columns as the window widens. The shell shows the navigation back-stack's current page;
         ViewLocator maps the page VM to its View. Shell chrome: a thin breadcrumb strip on top (the page
         trail — clickable ancestors, leading-ellipsis crop from the base end) and the floating bottom bar
         (back · search · ＋ menu · ⚙) overlaying the page. The ToastHost overlays transient messages app-wide.
         RootScale carries the Settings "interface scale": a layout transform over the WHOLE shell, so
         everything reflows at the chosen size (the masonry gains/loses columns) — user-chosen accessibility
         zoom, not the scaled-desktop-layout DESIGN.md rules out. Applied from code-behind (a transform can't
         data-bind — it has no DataContext). -->
    <LayoutTransformControl x:Name="RootScale">
        <Panel>
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="34" Padding="10,0"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                        TextElement.FontSize="{DynamicResource FontSizeSm}">
                    <ctrl:BreadcrumbBar Trail="{Binding Chrome.Crumbs}"
                                        NavigateCommand="{Binding Chrome.NavigateToCrumbCommand}"/>
                </Border>
                <ContentControl Content="{Binding Navigation.Current}"/>
            </DockPanel>
            <ctrl:FloatingBar x:Name="Bar" DataContext="{Binding Chrome}"/>

            <!-- Toasts overlay the page, and every sheet below overlays THEM. That ordering is only safe
                 because toasts no longer self-dismiss: a message arriving while a modal is open waits behind
                 the scrim instead of being missed, so nothing is lost by letting the modal own the screen.
                 Above the sheets it actively hurt — the details popup is opened BY a toast, so its own card
                 sat over the popup showing its content, and (being interactive now) intercepted clicks
                 meant for the sheet beneath. -->
            <ctrl:ToastHost DataContext="{Binding ToastService}"/>

            <!-- Shell-owned Settings sheet (the bar's ⚙). Its SheetHost raises the same IsOpenChanged the
                 page sheets do, so the bar hides beneath it. -->
            <ctrl:SheetHost IsOpen="{Binding Settings.IsOpen}" DismissCommand="{Binding Settings.CloseCommand}">
                <ctrl:SettingsSheet DataContext="{Binding Settings}"/>
            </ctrl:SheetHost>

            <!-- The "update available" prompt. Declared after Settings so it floats above it if a check
                 finishes while Settings is open; dismissing is "not now", never an install. -->
            <ctrl:SheetHost IsOpen="{Binding Update.IsOpen}" DismissCommand="{Binding Update.CloseCommand}">
                <ctrl:UpdateSheet DataContext="{Binding Update}"/>
            </ctrl:SheetHost>

            <!-- A toast's ⋯ ("show the full message") opens here. Last, so it floats over the other sheets —
                 the detail belongs to a message that can arrive while any of them is open. -->
            <ctrl:SheetHost IsOpen="{Binding ToastService.IsDetailsOpen}" CardMaxWidth="760"
                            DismissCommand="{Binding ToastService.CloseDetailsCommand}">
                <!-- CloseCommand resolves against the WINDOW's DataContext on purpose: this element's own
                     DataContext is the ToastItem, which knows nothing about the service that owns it. -->
                <ctrl:ToastDetailsSheet DataContext="{Binding ToastService.DetailsToast}"
                                        CloseCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToastService.CloseDetailsCommand}"/>
            </ctrl:SheetHost>
        </Panel>
    </LayoutTransformControl>
</Window>
