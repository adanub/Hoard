<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hoard.Desktop.ViewModels"
        xmlns:ctrl="using:Hoard.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Hoard.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="{DynamicResource BackgroundBrush}"
        Title="Hoard — Media Archive" Width="1100" Height="700">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Fluid reflow (Pinterest-style): pages lay out in real pixels and scroll naturally; the masonry grid
         gains columns as the window widens. The shell shows the navigation back-stack's current page;
         ViewLocator maps the page VM to its View. The ToastHost overlays transient messages app-wide. -->
    <Panel>
        <ContentControl Content="{Binding Navigation.Current}"/>
        <ctrl:ToastHost DataContext="{Binding ToastService}"/>
    </Panel>
</Window>
