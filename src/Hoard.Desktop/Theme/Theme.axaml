<!--
  Aggregates the Hoard design system: token + icon + component-theme resources, plus the surface/text styles.
  Include this once from App.axaml (after FluentTheme during the migration). See DESIGN.md.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hoard.Desktop/Theme/Tokens.axaml"/>
                <ResourceInclude Source="avares://Hoard.Desktop/Theme/Icons.axaml"/>
                <ResourceInclude Source="avares://Hoard.Desktop/Theme/Controls/Pressable.axaml"/>
                <ResourceInclude Source="avares://Hoard.Desktop/Theme/Controls/Button.axaml"/>
                <ResourceInclude Source="avares://Hoard.Desktop/Theme/Controls/Input.axaml"/>
                <ResourceInclude Source="avares://Hoard.Desktop/Theme/Controls/ListItem.axaml"/>
                <ResourceInclude Source="avares://Hoard.Desktop/Theme/Controls/Switch.axaml"/>
                <ResourceInclude Source="avares://Hoard.Desktop/Theme/Controls/Sheet.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://Hoard.Desktop/Theme/Controls/Surfaces.axaml"/>
</Styles>
