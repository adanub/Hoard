<!--
  Design tokens — the single source of truth for Hoard's visual language (see /DESIGN.md).
  The look blends shadcn/ui's contrast (thin borders, clear fills, strong text, an accent colour) with a
  glossy, tactile depth. Elevation reads from a GLOSS GRADIENT top sheen plus dark drop shadows. Shadows are
  kept dark and fairly TIGHT (small blur): a wide soft falloff changes <1 level/px and bands at 8-bit, while a
  steeper gradient changes several levels/px and stays clean. Base tones are not pure black/white. Light + dark
  via ThemeDictionaries. Bind via {DynamicResource ...}; never hardcode. Accent is one token (Primary/Accent/Ring).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- ── Light (soft-grey base, near-white raised surfaces) ── -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BackgroundBrush" Color="#E4E8EF"/>
            <SolidColorBrush x:Key="ForegroundBrush" Color="#1A1B22"/>
            <SolidColorBrush x:Key="CardBrush" Color="#F6F8FC"/>
            <SolidColorBrush x:Key="PopoverBrush" Color="#F8FAFD"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#DDE2EB"/>
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#646876"/>
            <SolidColorBrush x:Key="LineBrush" Color="#22000000"/>      <!-- black ~13% -->
            <SolidColorBrush x:Key="InputBrush" Color="#26000000"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#5B5BEF"/>      <!-- accent (indigo) -->
            <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#285B5BEF"/>     <!-- accent @ ~16% — selected/active -->
            <SolidColorBrush x:Key="RingBrush" Color="#5B5BEF"/>
            <SolidColorBrush x:Key="DestructiveBrush" Color="#DC2626"/>
            <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SelectionBrush" Color="#B35B5BEF"/>  <!-- text selection (accent ~70%) -->
            <SolidColorBrush x:Key="ScrimBrush" Color="#59000000"/>      <!-- modal sheet backdrop (~35% black) -->

            <!-- Glossy fills: a bright sheen sliver at the very top, then the body, then a darker base. -->
            <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#8585FA"/><GradientStop Offset="0.10" Color="#6E6EF3"/><GradientStop Offset="1" Color="#5050EC"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SecondaryGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFF"/><GradientStop Offset="0.10" Color="#FAFBFD"/><GradientStop Offset="1" Color="#E7EAF1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DestructiveGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#F36F6F"/><GradientStop Offset="0.10" Color="#EA4D4D"/><GradientStop Offset="1" Color="#CF2020"/>
            </LinearGradientBrush>

            <!-- DARK-only shadows (no light component → no fringe). -->
            <BoxShadows x:Key="ShadowMd">0 18 40 0 #2E000000</BoxShadows>
            <!-- Layered (contact + mid + ambient) so the soft falloff bands less than one long gradient. -->
            <BoxShadows x:Key="ShadowRaised">0 1 2 0 #1F000000, 0 5 12 0 #16000000, 0 12 30 0 #0F000000</BoxShadows>
            <BoxShadows x:Key="ShadowInset">inset 0 2 6 0 #22000000</BoxShadows>
            <BoxShadows x:Key="InputFocusShadow">inset 0 2 6 0 #22000000, inset 0 0 7 0 #4D5B5BEF</BoxShadows>
            <BoxShadows x:Key="ButtonRestShadow">0 2 4 0 #1F000000, inset 0 -2 3 0 #16000000</BoxShadows>
            <BoxShadows x:Key="ButtonPressedShadow">inset 0 2 5 0 #2E000000</BoxShadows>
        </ResourceDictionary>

        <!-- ── Dark (primary; raised surfaces clearly above bg) ──── -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BackgroundBrush" Color="#212025"/>
            <SolidColorBrush x:Key="ForegroundBrush" Color="#F3F3F7"/>
            <SolidColorBrush x:Key="CardBrush" Color="#1F1F23"/>
            <SolidColorBrush x:Key="PopoverBrush" Color="#2C2C33"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#302F37"/>
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#9A9AA8"/>
            <SolidColorBrush x:Key="LineBrush" Color="#2EFFFFFF"/>       <!-- white ~18% -->
            <SolidColorBrush x:Key="InputBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#6D6DF5"/>      <!-- accent (indigo) -->
            <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#386D6DF5"/>     <!-- accent @ ~22% — selected/active -->
            <SolidColorBrush x:Key="RingBrush" Color="#8385F7"/>
            <SolidColorBrush x:Key="DestructiveBrush" Color="#EF4444"/>
            <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SelectionBrush" Color="#B36D6DF5"/>  <!-- text selection (accent ~70%) -->
            <SolidColorBrush x:Key="ScrimBrush" Color="#99000000"/>      <!-- modal sheet backdrop (~60% black on dark) -->

            <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#9090FB"/><GradientStop Offset="0.10" Color="#7E7EF8"/><GradientStop Offset="1" Color="#5F5FF2"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SecondaryGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#35353D"/><GradientStop Offset="0.10" Color="#303039"/><GradientStop Offset="1" Color="#28272E"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DestructiveGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#F47373"/><GradientStop Offset="0.10" Color="#F25A5A"/><GradientStop Offset="1" Color="#DF2E2E"/>
            </LinearGradientBrush>

            <BoxShadows x:Key="ShadowMd">0 20 44 0 #99131219</BoxShadows>
            <!-- Dark drop, kept TIGHT (small blur): a wide soft falloff changes <1 level/px and bands at 8-bit;
                 these small blurs change >1 level/px (no bands). Two close layers for a touch of softness, both
                 still steep; alphas tuned to read clearly without being heavy. -->
            <BoxShadows x:Key="ShadowRaised">0 3 8 0 #80000000, 0 6 11 0 #59000000</BoxShadows>
            <BoxShadows x:Key="ShadowInset">inset 0 2 6 0 #80131219</BoxShadows>
            <BoxShadows x:Key="InputFocusShadow">inset 0 2 6 0 #80131219, inset 0 0 8 0 #596D6DF5</BoxShadows>
            <BoxShadows x:Key="ButtonRestShadow">0 2 4 0 #59131219, inset 0 -2 3 0 #40131219</BoxShadows>
            <BoxShadows x:Key="ButtonPressedShadow">inset 0 2 5 0 #73131219</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ── Variant-independent scalars ───────────────────────────── -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusLgTop">14,14,0,0</CornerRadius> <!-- RadiusLg on top corners only (card cover) -->
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <!-- Control heights (the direct size metric for buttons etc.; the icon button is square at ControlHeight). -->
    <x:Double x:Key="ControlHeight">38</x:Double>
    <x:Double x:Key="ControlHeightSm">28</x:Double>
    <x:Double x:Key="ControlHeightLg">48</x:Double>

    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>

    <x:Double x:Key="FontSizeXs">12</x:Double>
    <x:Double x:Key="FontSizeSm">13</x:Double>
    <x:Double x:Key="FontSizeBase">14</x:Double>
    <x:Double x:Key="FontSizeLg">16</x:Double>
    <x:Double x:Key="FontSizeXl">20</x:Double>
    <x:Double x:Key="FontSize2Xl">24</x:Double>

    <!-- Edge: a dark overlay border defining a coloured (gradient) button's edge. Works on any fill. -->
    <SolidColorBrush x:Key="EdgeBrush" Color="#33000000"/>

    <!-- Text shadow for white-on-colour text (primary/destructive): always dark — that text is light in
         both themes, so the inverse-luminance shadow is always dark. -->
    <DropShadowEffect x:Key="OnAccentTextShadowEffect" BlurRadius="0" OffsetX="0" OffsetY="1" Color="#000000" Opacity="0.5"/>

    <!-- Flat (no elevation) — outline/ghost buttons. -->
    <BoxShadows x:Key="ShadowNone">0 0 0 0 #00000000</BoxShadows>
</ResourceDictionary>
