<!--
  TextBox — a recessed (inset) field: it looks pressed *into* the surface, with a thin border and accent
  focus ring. Template structure follows Avalonia's own TextBox theme (critically, the TextPresenter binds
  SelectionStart/SelectionEnd/CaretIndex — without those, selection and caret don't render). Opt-in via
  Theme="{StaticResource HoardInput}". See DESIGN.md.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="HoardInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Cursor" Value="Ibeam"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="root" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource ShadowInset}">
                    <ScrollViewer Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                        <!-- Alignment comes from VerticalContentAlignment, NOT a literal: a value written in
                             a template applies at Template priority, which a plain (non-pseudo-class) style
                             selector can't override — so `^ /template/ Panel#content` would silently lose and
                             HoardTextArea could never top-align its text. -->
                        <Panel Name="content" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextBlock Name="placeholder" Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"
                                       IsVisible="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                            <TextPresenter Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           PasswordChar="{TemplateBinding PasswordChar}"
                                           RevealPassword="{TemplateBinding RevealPassword}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Panel>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Focused (clicked or tabbed): primary-tinted border + an indigo glow in the recessed bevel. -->
        <Style Selector="^:focus /template/ Border#root">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource InputFocusShadow}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </ControlTheme>

    <!--
      Multi-line variant, for text to be READ (a log, a run's failures, a stack trace) rather than typed into:
      the same recessed field, but the text starts at the TOP and long content SCROLLS vertically instead of
      widening the box. HoardInput centres a single line and floors the height at 40 — both wrong past one
      line. Horizontal scrolling is off on purpose: wrapping is what keeps the content inside the card.
      Pair with IsReadOnly + a copy button (a read-only TextBox's own Copy() sidesteps Avalonia 12's
      DataTransfer/DataFormat clipboard API). Bound the height at the call site.
    -->
    <ControlTheme x:Key="HoardTextArea" TargetType="TextBox" BasedOn="{StaticResource HoardInput}">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="Ibeam"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </ControlTheme>
</ResourceDictionary>
