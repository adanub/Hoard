<!--
  TextBox — a recessed (inset) field: it looks pressed *into* the surface, with a thin border and accent
  focus ring. Template structure follows Avalonia's own TextBox theme (critically, the TextPresenter binds
  SelectionStart/SelectionEnd/CaretIndex — without those, selection and caret don't render). Opt-in via
  Theme="{StaticResource HoardInput}". See DESIGN.md.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="HoardInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Cursor" Value="Ibeam"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="root" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource ShadowInset}">
                    <ScrollViewer Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                        <Panel VerticalAlignment="Center">
                            <TextBlock Name="placeholder" Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"
                                       IsVisible="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                            <TextPresenter Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           PasswordChar="{TemplateBinding PasswordChar}"
                                           RevealPassword="{TemplateBinding RevealPassword}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           VerticalAlignment="Center"/>
                        </Panel>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Focused (clicked or tabbed): primary-tinted border + an indigo glow in the recessed bevel. -->
        <Style Selector="^:focus /template/ Border#root">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource InputFocusShadow}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
