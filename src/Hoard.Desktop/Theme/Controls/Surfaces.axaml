<!--
  Surfaces & helpers — Card, Badge, and text-helper styles (see DESIGN.md). These are class-based styles on
  plain Border/TextBlock, additive so they coexist with FluentTheme. Interactive controls (Button, Input,
  Switch, and the tappable list Row) are ControlThemes under Theme/Controls/, not here.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card: an elevated surface. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowRaised}"/>
    </Style>

    <!-- Badge: a small floating pill (counts, GIF tag) — gloss-bevelled fill + thin border + drop shadow so
         it reads as lifted off the row. -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource SecondaryGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="BoxShadow" Value="{DynamicResource ButtonRestShadow}"/>
    </Style>

    <!-- Progress bars use the accent (the Fluent default is a low-contrast grey that's unreadable on muted
         surfaces like an importing board's empty collage). The indicator picks up Foreground. -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <!-- Typography helpers. -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{DynamicResource FontSize2Xl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
    </Style>
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
</Styles>
