<!--
  Button — glossy, tactile, shadcn-meets-neumorphism (see DESIGN.md). The "light" comes from a gloss gradient
  fill; box-shadows are dark-only. On press the button shrinks slightly (scale) and the bevel insets.
  Text shadow only on white-on-colour text (primary/destructive) and always dark; neutral variants
  (secondary/outline/ghost) carry no text shadow — see the locked inverse-luminance rule in DESIGN.md.
  Opt-in via Theme="{StaticResource HoardButton}"; variants/sizes are classes:
    Classes="secondary | outline | ghost | destructive"   and   Classes="sm | icon"
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:Hoard.Desktop.Controls">

    <ControlTheme x:Key="HoardButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <!-- Height is the size metric (fixed); horizontal padding sets width, content centres vertically. -->
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <!-- Don't clip the press transform (the button nudges down a px on press) to the control bounds. -->
        <Setter Property="ClipToBounds" Value="False"/>
        <!-- Shared pressable-surface scaffold (Border#root + hit-transparent content + press transition). -->
        <Setter Property="Template" Value="{StaticResource PressableSurfaceTemplate}"/>

        <!-- Rest elevation (gloss bevel + small even drop). Set via style so flat variants can override. -->
        <Style Selector="^ /template/ Border#root">
            <Setter Property="BoxShadow" Value="{DynamicResource ButtonRestShadow}"/>
        </Style>

        <!-- Text shadow = inverse luminance of the text (locked rule, see DESIGN.md). White-on-colour text
             (primary/destructive, light in both themes) → always-dark shadow. -->
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Effect" Value="{DynamicResource OnAccentTextShadowEffect}"/>
        </Style>
        <!-- Neutral variants sit on a near-background fill, so an inverse-luminance shadow is invisible in
             light mode (a light emboss can't show on a near-white surface) and only adds apparent weight in
             dark mode. The consistent choice across themes is therefore no text shadow on these.
             NOTE: this override must stay AFTER the base setter above and keep its higher specificity (the
             class condition) — clearing the Effect here is what prevents a dark shadow under dark neutral
             text; reordering or weakening this selector silently reintroduces that regression. -->
        <Style Selector="^.secondary /template/ ContentPresenter#PART_ContentPresenter, ^.outline /template/ ContentPresenter#PART_ContentPresenter, ^.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>

        <!-- A label wider than the button pans end-to-end (the template's Marquee) while hovered/pressed,
             so a cropped caption becomes readable without growing the layout; it snaps home on leave. -->
        <Style Selector="^:pointerover /template/ ctrl|Marquee#marquee">
            <Setter Property="IsActive" Value="True"/>
        </Style>
        <Style Selector="^:pressed /template/ ctrl|Marquee#marquee">
            <Setter Property="IsActive" Value="True"/>
        </Style>

        <!-- Press: the whole button face sinks down + shrinks (label rides along, staying centred) and the
             bevel insets — reads as pushed into the surface. ClipToBounds=False (above) gives the sink room. -->
        <Style Selector="^:pressed /template/ Border#root">
            <Setter Property="BoxShadow" Value="{DynamicResource ButtonPressedShadow}"/>
            <Setter Property="RenderTransform" Value="translate(0px,1px) scale(0.97)"/>
        </Style>

        <Style Selector="^:pointerover /template/ Border#root">
            <Setter Property="Opacity" Value="0.93"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#root">
            <Setter Property="BorderBrush" Value="{DynamicResource RingBrush}"/>
        </Style>

        <!-- Variants -->
        <Style Selector="^.secondary">
            <Setter Property="Background" Value="{DynamicResource SecondaryGradientBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        </Style>
        <Style Selector="^.destructive">
            <Setter Property="Background" Value="{DynamicResource DestructiveGradientBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DestructiveForegroundBrush}"/>
        </Style>
        <!-- Outline & ghost share one behaviour: bare and flat at rest, then on hover they lift into the
             SAME glossy, bevelled neutral as Secondary (gradient fill + border + raised bevel). The only
             difference is outline keeps a border at rest; ghost shows none until it lifts. -->
        <Style Selector="^.outline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        </Style>
        <Style Selector="^.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Flat at rest (no bevel). -->
        <Style Selector="^.outline /template/ Border#root, ^.ghost /template/ Border#root">
            <Setter Property="BoxShadow" Value="{DynamicResource ShadowNone}"/>
        </Style>
        <!-- Hover: become Secondary — glossy gradient fill, border, raised bevel (no dimming). -->
        <Style Selector="^.outline:pointerover, ^.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SecondaryGradientBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        </Style>
        <Style Selector="^.outline:pointerover /template/ Border#root, ^.ghost:pointerover /template/ Border#root">
            <Setter Property="BoxShadow" Value="{DynamicResource ButtonRestShadow}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Press: inset like the other raised buttons. Must follow the hover rule above so it wins at equal
             specificity (both are class + pseudo) when pressed-and-hovered. -->
        <Style Selector="^.outline:pressed /template/ Border#root, ^.ghost:pressed /template/ Border#root">
            <Setter Property="BoxShadow" Value="{DynamicResource ButtonPressedShadow}"/>
        </Style>

        <!-- Sizes: each sets an explicit Height (the size metric); padding/font fit within. -->
        <Style Selector="^.sm">
            <Setter Property="Height" Value="{DynamicResource ControlHeightSm}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        </Style>
        <Style Selector="^.lg">
            <Setter Property="Height" Value="{DynamicResource ControlHeightLg}"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLg}"/>
        </Style>
        <!-- Icon: square at the default height. -->
        <Style Selector="^.icon">
            <Setter Property="Width" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- …and square again at the small height: .icon takes its Width from the DEFAULT height, so an
             .icon.sm without this comes out wider than it is tall (a lopsided ✕ on a toast card). -->
        <Style Selector="^.icon.sm">
            <Setter Property="Width" Value="{DynamicResource ControlHeightSm}"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
