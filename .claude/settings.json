{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && sh \"$root/tools/git-hooks/install-hooks.sh\" || true",
            "timeout": 10,
            "statusMessage": "Installing the attribution-stripping commit-msg hook"
          }
        ]
      }
    ]
  }
}
