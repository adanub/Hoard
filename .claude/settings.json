{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "h=\"$(git rev-parse --git-path hooks)\" && mkdir -p \"$h\" && cp tools/git-hooks/commit-msg \"$h/commit-msg\" && chmod +x \"$h/commit-msg\" || true",
            "timeout": 10,
            "statusMessage": "Installing the attribution-stripping commit-msg hook"
          }
        ]
      }
    ]
  }
}
